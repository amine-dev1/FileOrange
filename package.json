{
  "name": "file-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "lint": "eslint .",
    "notices": "node scripts/gen-notices.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "get-pdfium": "node scripts/get-pdfium.mjs",
    "pretauri": "node scripts/get-pdfium.mjs",
    "get-libreoffice": "node scripts/get-libreoffice.mjs",
    "build:installer": "node scripts/get-pdfium.mjs && node scripts/get-libreoffice.mjs && node scripts/gen-notices.mjs && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0"
  }
}
