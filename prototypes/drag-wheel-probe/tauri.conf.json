{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragWheelProbe",
  "version": "0.0.1",
  "identifier": "com.filetool.dragwheelprobe",
  "build": { "frontendDist": "./web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Drag wheel probe", "url": "index.html", "width": 760, "height": 640, "visible": true, "dragDropEnabled": false },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 420,
        "height": 420,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
