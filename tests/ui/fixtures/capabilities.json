    {
      "id": "convert_image",
      "label": "Convert images",
      "description": "Convert between JPG, PNG and WEBP. Originals are never changed.",
      "inputs": [
        "jpeg",
        "png",
        "webp"
      ],
      "outputs": [
        "jpeg",
        "png",
        "webp"
      ],
      "pairs": [
        {
          "from": "jpeg",
          "to": "jpeg",
          "notes": [
            "JPG is lossy: each save reduces quality slightly.",
            "Same format: the image is re-encoded (useful to remove metadata or change quality)."
          ]
        },
        {
          "from": "jpeg",
          "to": "png",
          "notes": [
            "PNG is lossless, so the file is usually larger and lost quality does not come back."
          ]
        },
        {
          "from": "jpeg",
          "to": "webp",
          "notes": [
            "WebP can be lossy (smaller files) or lossless (exact pixels). Transparency is kept."
          ]
        },
        {
          "from": "png",
          "to": "jpeg",
          "notes": [
            "JPG is lossy: each save reduces quality slightly.",
            "Transparent areas are filled with a solid background colour (white by default)."
          ]
        },
        {
          "from": "png",
          "to": "png",
          "notes": [
            "Same format: the image is re-encoded (useful to remove metadata or change quality)."
          ]
        },
        {
          "from": "png",
          "to": "webp",
          "notes": [
            "WebP can be lossy (smaller files) or lossless (exact pixels). Transparency is kept."
          ]
        },
        {
          "from": "webp",
          "to": "jpeg",
          "notes": [
            "JPG is lossy: each save reduces quality slightly.",
            "Transparent areas are filled with a solid background colour (white by default)."
          ]
        },
        {
          "from": "webp",
          "to": "png",
          "notes": [
            "PNG is lossless, so the file is usually larger and lost quality does not come back."
          ]
        },
        {
          "from": "webp",
          "to": "webp",
          "notes": [
            "WebP can be lossy (smaller files) or lossless (exact pixels). Transparency is kept.",
            "Same format: the image is re-encoded (useful to remove metadata or change quality)."
          ]
        }
      ],
      "options": [
        {
          "id": "webp_mode",
          "label": "WebP mode",
          "help": "Lossy makes smaller files. Lossless keeps every pixel exactly.",
          "kind": {
            "type": "choice",
            "choices": [
              {
                "value": "lossy",
                "label": "Lossy (smaller)"
              },
              {
                "value": "lossless",
                "label": "Lossless (exact)"
              }
            ],
            "default": "lossy"
          },
          "applies_to": [
            {
              "format": "webp",
              "when": null
            }
          ]
        },
        {
          "id": "quality",
          "label": "Quality",
          "help": "Higher looks better but makes bigger files.",
          "kind": {
            "type": "int",
            "min": 1,
            "max": 100,
            "default": 85
          },
          "applies_to": [
            {
              "format": "jpeg",
              "when": null
            },
            {
              "format": "webp",
              "when": {
                "option": "webp_mode",
                "equals": "lossy"
              }
            }
          ]
        },
        {
          "id": "background",
          "label": "Background for transparent areas",
          "help": "JPG can't store transparency, so transparent areas are filled with this colour.",
          "kind": {
            "type": "color",
            "default": "#FFFFFF"
          },
          "applies_to": [
            {
              "format": "jpeg",
              "when": null
            }
          ]
        },
        {
          "id": "keep_metadata",
          "label": "Keep photo information",
          "help": "Camera details and location (EXIF). Off by default for privacy. The colour profile is always kept.",
          "kind": {
            "type": "bool",
            "default": false
          },
          "applies_to": []
        }
      ],
      "interactive": false,
      "engine": "image",
      "available": true,
      "unavailable_reason": null
    },
